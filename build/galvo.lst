  23:Galvo/galvo.c **** #include <math.h>
  24:Galvo/galvo.c **** 
  25:Galvo/galvo.c **** /* ---- XY2-100 帧结构 ------------------------------------------------------ */
  26:Galvo/galvo.c **** #define XY_BEATS        20U                 /* 一帧 20 个时钟周期            */
  27:Galvo/galvo.c **** #define XY_BUF_WORDS    (XY_BEATS * 2U)     /* 乒乓双缓冲: 两帧共 40 个 word */
  28:Galvo/galvo.c **** 
  29:Galvo/galvo.c **** /* GPIOB->BSRR 位掩码 (低 16 位=置位, 高 16 位=复位) */
ARM GAS  C:\Users\Lenovo\AppData\Local\Temp\ccoSb17R.s 			page 2


  30:Galvo/galvo.c **** #define M_SYNC          (1UL << 7)          /* PB7 */
  31:Galvo/galvo.c **** #define M_X             (1UL << 5)          /* PB5 */
  32:Galvo/galvo.c **** #define M_Y             (1UL << 6)          /* PB6 */
  33:Galvo/galvo.c **** 
  34:Galvo/galvo.c **** /* 一个 BSRR 控制字: 同时确定 SYNC/X/Y 三条线的电平 */
  35:Galvo/galvo.c **** #define BSRR_LEVEL(mask, lvl)  ((lvl) ? (mask) : ((mask) << 16))
  36:Galvo/galvo.c **** 
  37:Galvo/galvo.c **** /* ---- 双半区缓冲 ---------------------------------------------------------- */
  38:Galvo/galvo.c **** static uint32_t galvo_frame[2][XY_BEATS];   /* DMA 搬运区，[0]=A 半区，[1]=B 半区 */
  39:Galvo/galvo.c **** static uint32_t galvo_stage[XY_BEATS];      /* 主循环编码区 */
  40:Galvo/galvo.c **** 
  41:Galvo/galvo.c **** /* 代号：stage 写完才自增；半区拷贝完才跟上，主循环据此判断能否覆盖 st
  42:Galvo/galvo.c **** static volatile uint32_t galvo_stage_gen = 0U;
  43:Galvo/galvo.c **** static volatile uint32_t galvo_a_gen = 0U;
  44:Galvo/galvo.c **** static volatile uint32_t galvo_b_gen = 0U;
  45:Galvo/galvo.c **** 
  46:Galvo/galvo.c **** static uint8_t galvo_ctrl = 0x1U;           /* 控制字 001 */
  47:Galvo/galvo.c **** 
  48:Galvo/galvo.c **** static volatile uint32_t galvo_dma_err = 0U;
  49:Galvo/galvo.c **** 
  50:Galvo/galvo.c **** /* ---- S 曲线规划 ---------------------------------------------------------- */
  51:Galvo/galvo.c **** typedef enum
  52:Galvo/galvo.c **** {
  53:Galvo/galvo.c ****   GALVO_IDLE = 0,               /* 等待下一个目标点 */
  54:Galvo/galvo.c ****   GALVO_MOVING                  /* 正在按 S 曲线走向目标点 */
  55:Galvo/galvo.c **** } galvo_plan_state_t;
  56:Galvo/galvo.c **** 
  57:Galvo/galvo.c **** static SCurve galvo_scurve;
  58:Galvo/galvo.c **** static galvo_plan_state_t galvo_plan_state = GALVO_IDLE;
  59:Galvo/galvo.c **** static int16_t galvo_cur_x = 0;            /* 当前输出的坐标 */
  60:Galvo/galvo.c **** static int16_t galvo_cur_y = 0;
  61:Galvo/galvo.c **** static uint32_t galvo_last_point_cycle = 0U;   /* 上一个规划点的输出时刻 */
  62:Galvo/galvo.c **** static uint32_t galvo_last_arrive_cycle = 0U;  /* 到达上一个目标点的时刻 */
  63:Galvo/galvo.c **** static uint8_t  galvo_laser_off_pending = 0U;  /* 已到位，待稳定结束后关光 */
  64:Galvo/galvo.c **** 
  65:Galvo/galvo.c **** /* µs → DWT 周期（168 MHz 下 1 µs = 168 周期） */
  66:Galvo/galvo.c **** static uint32_t galvo_us_to_cycles(uint32_t us)
  67:Galvo/galvo.c **** {
  68:Galvo/galvo.c ****   return us * (SystemCoreClock / 1000000U);
  69:Galvo/galvo.c **** }
  70:Galvo/galvo.c **** 
  71:Galvo/galvo.c **** /* ---- 调试计时 ---- */
  72:Galvo/galvo.c **** volatile uint32_t g_dma_copy_cycles = 0U;
  73:Galvo/galvo.c **** volatile uint32_t g_rx_to_dma_cycles = 0U;
  74:Galvo/galvo.c **** 
  75:Galvo/galvo.c **** /* ===================== 临时测试：S 曲线日志（测完整块删除） =============== */
  76:Galvo/galvo.c **** #define GALVO_TEST_LOG   1
  77:Galvo/galvo.c **** #if GALVO_TEST_LOG
  78:Galvo/galvo.c **** #define GTEST_SEGS       16U
