 109:Galvo/galvo.c **** 
 110:Galvo/galvo.c **** /* ---- LUT ---------------------------------------------------------------- */
 111:Galvo/galvo.c **** 
 112:Galvo/galvo.c **** /**
 113:Galvo/galvo.c ****   * @brief 双线性插值取样，ax/ay 为坐标绝对值（0..32768）
 114:Galvo/galvo.c ****   * @retval 校正量（弧度），未标定时为 0
 115:Galvo/galvo.c ****   */
 116:Galvo/galvo.c **** static float galvo_lut_sample(const int16_t lut[GALVO_LUT_SIZE][GALVO_LUT_SIZE],
 117:Galvo/galvo.c ****                               uint32_t ax, uint32_t ay)
 118:Galvo/galvo.c **** {
 119:Galvo/galvo.c ****   uint32_t ix, iy;
 120:Galvo/galvo.c ****   float fx, fy, v00, v10, v01, v11, top, bot;
 121:Galvo/galvo.c **** 
 122:Galvo/galvo.c ****   if (ax > 32767U) { ax = 32767U; }
 123:Galvo/galvo.c ****   if (ay > 32767U) { ay = 32767U; }
 124:Galvo/galvo.c **** 
 125:Galvo/galvo.c ****   ix = ax >> 8;
 126:Galvo/galvo.c ****   iy = ay >> 8;
 127:Galvo/galvo.c **** 
 128:Galvo/galvo.c ****   /* 插值需要 i+1，索引限制在 0..126；末段的分数部分截到 1.0 */
 129:Galvo/galvo.c ****   if (ix > (GALVO_LUT_SIZE - 2U)) { ix = GALVO_LUT_SIZE - 2U; }
 130:Galvo/galvo.c ****   if (iy > (GALVO_LUT_SIZE - 2U)) { iy = GALVO_LUT_SIZE - 2U; }
 131:Galvo/galvo.c **** 
 132:Galvo/galvo.c ****   fx = (float)(ax - (ix << 8)) * (1.0f / 256.0f);
 133:Galvo/galvo.c ****   fy = (float)(ay - (iy << 8)) * (1.0f / 256.0f);
 134:Galvo/galvo.c ****   if (fx > 1.0f) { fx = 1.0f; }
 135:Galvo/galvo.c ****   if (fy > 1.0f) { fy = 1.0f; }
 136:Galvo/galvo.c **** 
 137:Galvo/galvo.c ****   v00 = (float)lut[iy][ix];
 138:Galvo/galvo.c ****   v10 = (float)lut[iy][ix + 1U];
 139:Galvo/galvo.c ****   v01 = (float)lut[iy + 1U][ix];
 140:Galvo/galvo.c ****   v11 = (float)lut[iy + 1U][ix + 1U];
 141:Galvo/galvo.c **** 
 142:Galvo/galvo.c ****   top = v00 + (v10 - v00) * fx;
 143:Galvo/galvo.c ****   bot = v01 + (v11 - v01) * fx;
ARM GAS  C:\Users\Lenovo\AppData\Local\Temp\ccoSb17R.s 			page 4


 144:Galvo/galvo.c ****   return (top + (bot - top) * fy) * GALVO_LUT_UNIT;
 145:Galvo/galvo.c **** }
 146:Galvo/galvo.c **** 
 147:Galvo/galvo.c **** /**
 148:Galvo/galvo.c ****   * @brief 单轴：α = sgn(d) × (|d|/(2f) + LUT)，再换算成 16bit 命令字
 149:Galvo/galvo.c ****   *
 150:Galvo/galvo.c ****   * @param  d      有符号坐标
 151:Galvo/galvo.c ****   * @param  ax/ay  坐标绝对值，用于查表
 152:Galvo/galvo.c ****   * @param  offset 该轴的零点角度 α0/β0
 153:Galvo/galvo.c ****   */
 154:Galvo/galvo.c **** static uint16_t galvo_axis_cmd(int32_t d, uint32_t ax, uint32_t ay,
 155:Galvo/galvo.c ****                                const int16_t lut[GALVO_LUT_SIZE][GALVO_LUT_SIZE],
 156:Galvo/galvo.c ****                                float offset)
 157:Galvo/galvo.c **** {
 158:Galvo/galvo.c ****   float ang = (float)ax / (2.0f * GALVO_F) + galvo_lut_sample(lut, ax, ay);
 159:Galvo/galvo.c ****   int32_t cmd;
 160:Galvo/galvo.c **** 
 161:Galvo/galvo.c ****   if (d < 0) { ang = -ang; }
 162:Galvo/galvo.c **** 
 163:Galvo/galvo.c ****   cmd = (int32_t)lroundf((ang - offset) * GALVO_COUNTS_PER_RAD + GALVO_CMD_CENTER);
 164:Galvo/galvo.c **** 
 165:Galvo/galvo.c ****   if (cmd < 0)      { cmd = 0; }
 166:Galvo/galvo.c ****   if (cmd > 65535)  { cmd = 65535; }
 167:Galvo/galvo.c **** 
 168:Galvo/galvo.c ****   return (uint16_t)cmd;
 169:Galvo/galvo.c **** }
 170:Galvo/galvo.c **** 
 171:Galvo/galvo.c **** /**
 172:Galvo/galvo.c ****   * @brief 把一对坐标换算成命令字并编码成一帧 20 个 BSRR 控制字
 173:Galvo/galvo.c ****   */
 174:Galvo/galvo.c **** static void galvo_build_stage(int16_t x, int16_t y, uint32_t *buf)
 175:Galvo/galvo.c **** {
 176:Galvo/galvo.c ****   uint32_t ax = (uint32_t)(x < 0 ? -(int32_t)x : (int32_t)x);
 177:Galvo/galvo.c ****   uint32_t ay = (uint32_t)(y < 0 ? -(int32_t)y : (int32_t)y);
 178:Galvo/galvo.c **** 
 179:Galvo/galvo.c ****   uint16_t cx = galvo_axis_cmd(x, ax, ay, galvo_lut_alpha, GALVO_ALPHA0);
 180:Galvo/galvo.c ****   uint16_t cy = galvo_axis_cmd(y, ax, ay, galvo_lut_beta,  GALVO_BETA0);
 181:Galvo/galvo.c **** 
 182:Galvo/galvo.c ****   galvo_encode(cx, cy, buf);
 183:Galvo/galvo.c **** }
 184:Galvo/galvo.c **** 
 185:Galvo/galvo.c **** /**
 186:Galvo/galvo.c ****   * @brief 编码一帧 XY2-100
 187:Galvo/galvo.c ****   *
 188:Galvo/galvo.c ****   * 20 bit, MSB first:
 189:Galvo/galvo.c ****   *   bit 0..2   C2 C1 C0（控制字）
 190:Galvo/galvo.c ****   *   bit 3..18  16bit 命令字，offset binary
 191:Galvo/galvo.c ****   *   bit 19     偶校验（对前 19 位异或）
 192:Galvo/galvo.c ****   * SYNC 前 19 拍为高，第 20 拍拉低。
 193:Galvo/galvo.c ****   */
 194:Galvo/galvo.c **** static void galvo_encode(uint16_t cx, uint16_t cy, uint32_t *buf)
 195:Galvo/galvo.c **** {
 196:Galvo/galvo.c ****   uint32_t ctrl = ((uint32_t)galvo_ctrl & 0x7U) << 16;
 197:Galvo/galvo.c ****   uint32_t wx = ctrl | cx;
 198:Galvo/galvo.c ****   uint32_t wy = ctrl | cy;
 199:Galvo/galvo.c ****   uint32_t px = 0U, py = 0U;
 200:Galvo/galvo.c **** 
ARM GAS  C:\Users\Lenovo\AppData\Local\Temp\ccoSb17R.s 			page 5


 201:Galvo/galvo.c ****   for (uint32_t i = 0U; i < 19U; i++)
 202:Galvo/galvo.c ****   {
 203:Galvo/galvo.c ****     uint32_t bx = (wx >> (18U - i)) & 1U;
 204:Galvo/galvo.c ****     uint32_t by = (wy >> (18U - i)) & 1U;
 205:Galvo/galvo.c **** 
 206:Galvo/galvo.c ****     px ^= bx;
 207:Galvo/galvo.c ****     py ^= by;
 208:Galvo/galvo.c **** 
 209:Galvo/galvo.c ****     /* 三条线每个节拍都必须明确置位或复位，BSRR 没有"保持"语义 */
 210:Galvo/galvo.c ****     buf[i] = BSRR_LEVEL(M_SYNC, 1U) | BSRR_LEVEL(M_X, bx) | BSRR_LEVEL(M_Y, by);
 211:Galvo/galvo.c ****   }
 212:Galvo/galvo.c **** 
 213:Galvo/galvo.c ****   buf[19] = BSRR_LEVEL(M_SYNC, 0U) | BSRR_LEVEL(M_X, px) | BSRR_LEVEL(M_Y, py);
 214:Galvo/galvo.c **** }
 215:Galvo/galvo.c **** 
 216:Galvo/galvo.c **** #if GALVO_TEST_LOG
 217:Galvo/galvo.c **** /* 记录一个规划点（只在主循环调用，写内存，不影响波形） */
 218:Galvo/galvo.c **** static void gtest_record(uint32_t now, uint32_t step, int16_t x, int16_t y)
 219:Galvo/galvo.c **** {
 220:Galvo/galvo.c ****   uint8_t s = gtest_seg;
 221:Galvo/galvo.c ****   uint32_t k;
 222:Galvo/galvo.c **** 
 223:Galvo/galvo.c ****   if ((s >= GTEST_SEGS) || (step == 0U) || (step > SCURVE_POINTS))
 224:Galvo/galvo.c ****   {
 225:Galvo/galvo.c ****     return;
 226:Galvo/galvo.c ****   }
 227:Galvo/galvo.c **** 
 228:Galvo/galvo.c ****   k = step - 1U;
 229:Galvo/galvo.c **** 
 230:Galvo/galvo.c ****   gtest_t[s][k] = now;
 231:Galvo/galvo.c ****   gtest_x[s][k] = x;
 232:Galvo/galvo.c ****   gtest_y[s][k] = y;
 233:Galvo/galvo.c ****   gtest_dt[s][k] = (gtest_last_t == 0U) ? 0U : (now - gtest_last_t);
 234:Galvo/galvo.c ****   gtest_last_t = now;
 235:Galvo/galvo.c **** 
 236:Galvo/galvo.c ****   if (k == (SCURVE_POINTS - 1U))
 237:Galvo/galvo.c ****   {
 238:Galvo/galvo.c ****     gtest_pending_seg = s;
 239:Galvo/galvo.c ****     gtest_settle_pending = 1U;
 240:Galvo/galvo.c ****     gtest_seg = (uint8_t)(s + 1U);      /* 等于 GTEST_SEGS 后停止记录 */
 241:Galvo/galvo.c ****   }
 242:Galvo/galvo.c **** }
 243:Galvo/galvo.c **** #endif
 244:Galvo/galvo.c **** 
 245:Galvo/galvo.c **** /* ---- DMA 中断：帧边界搬运 ------------------------------------------------ */
 246:Galvo/galvo.c **** 
 247:Galvo/galvo.c **** /* 上半区(A)刚发完，DMA 正在发 B，可以重填 A */
 248:Galvo/galvo.c **** static void galvo_dma_half_cb(DMA_HandleTypeDef *hdma)
 249:Galvo/galvo.c **** {
 250:Galvo/galvo.c ****   if (hdma->Instance == DMA2_Stream5)
 251:Galvo/galvo.c ****   {
 252:Galvo/galvo.c ****     if (galvo_a_gen != galvo_stage_gen)
 253:Galvo/galvo.c ****     {
 254:Galvo/galvo.c ****       uint32_t a = DWT->CYCCNT;             /* 拷贝前 */
 255:Galvo/galvo.c ****       uint32_t b;
 256:Galvo/galvo.c **** 
 257:Galvo/galvo.c ****       memcpy(galvo_frame[0], galvo_stage, sizeof(galvo_stage));
ARM GAS  C:\Users\Lenovo\AppData\Local\Temp\ccoSb17R.s 			page 6


 258:Galvo/galvo.c ****       __DMB();
 259:Galvo/galvo.c ****       galvo_a_gen = galvo_stage_gen;
 260:Galvo/galvo.c **** 
 261:Galvo/galvo.c ****       b = DWT->CYCCNT;                      /* 拷贝后 */
 262:Galvo/galvo.c ****       g_dma_copy_cycles = b - a;
 263:Galvo/galvo.c ****       g_rx_to_dma_cycles = b - g_comm_last_rx_cycle;
 264:Galvo/galvo.c ****     }
 265:Galvo/galvo.c ****   }
 266:Galvo/galvo.c **** }
 267:Galvo/galvo.c **** 
 268:Galvo/galvo.c **** /* 下半区(B)刚发完，DMA 绕回 A，可以重填 B */
 269:Galvo/galvo.c **** static void galvo_dma_cplt_cb(DMA_HandleTypeDef *hdma)
 270:Galvo/galvo.c **** {
 271:Galvo/galvo.c ****   if (hdma->Instance == DMA2_Stream5)
 272:Galvo/galvo.c ****   {
 273:Galvo/galvo.c ****     if (galvo_b_gen != galvo_stage_gen)
 274:Galvo/galvo.c ****     {
 275:Galvo/galvo.c ****       uint32_t a = DWT->CYCCNT;             /* 拷贝前 */
 276:Galvo/galvo.c ****       uint32_t b;
 277:Galvo/galvo.c **** 
 278:Galvo/galvo.c ****       memcpy(galvo_frame[1], galvo_stage, sizeof(galvo_stage));
 279:Galvo/galvo.c ****       __DMB();
 280:Galvo/galvo.c ****       galvo_b_gen = galvo_stage_gen;
 281:Galvo/galvo.c **** 
 282:Galvo/galvo.c ****       b = DWT->CYCCNT;                      /* 拷贝后 */
 283:Galvo/galvo.c ****       g_dma_copy_cycles = b - a;
 284:Galvo/galvo.c ****       g_rx_to_dma_cycles = b - g_comm_last_rx_cycle;
 285:Galvo/galvo.c ****     }
 286:Galvo/galvo.c ****   }
