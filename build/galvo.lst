   1:Galvo/galvo.c **** /**
   2:Galvo/galvo.c ****   ******************************************************************************
   3:Galvo/galvo.c ****   * @file    galvo.c
   4:Galvo/galvo.c ****   * @brief   XY2-100 输出：坐标 → 角度 → 命令字 → 20 拍 BSRR 编码 → 循环 DMA
   5:Galvo/galvo.c ****   *
   6:Galvo/galvo.c ****   * 分工：
   7:Galvo/galvo.c ****   *   - 主循环 Galvo_Task()：取点、查 LUT、换算、编码到 stage[]，发布代号；
   8:Galvo/galvo.c ****   *   - DMA 中断：帧边界把 stage[] 拷到刚发完的那半区（A/B 乒乓）；
   9:Galvo/galvo.c ****   *   - DMA 硬件：循环读取 40 个 word 写 GPIOB->BSRR，永不停止。
  10:Galvo/galvo.c ****   * 因此波形连续性由硬件保证，软件只在帧边界改数据。
  11:Galvo/galvo.c ****   ******************************************************************************
  12:Galvo/galvo.c ****   */
  13:Galvo/galvo.c **** 
  14:Galvo/galvo.c **** #include "galvo.h"
  15:Galvo/galvo.c **** #include "galvo_lut.h"
  16:Galvo/galvo.c **** #include "comm.h"
  17:Galvo/galvo.c **** #include "tim.h"
  18:Galvo/galvo.c **** #include "main.h"
  19:Galvo/galvo.c **** 
  20:Galvo/galvo.c **** #include <string.h>
  21:Galvo/galvo.c **** #include <math.h>
  22:Galvo/galvo.c **** 
  23:Galvo/galvo.c **** /* ---- XY2-100 帧结构 ------------------------------------------------------ */
  24:Galvo/galvo.c **** #define XY_BEATS        20U                 /* 一帧 20 个时钟周期            */
  25:Galvo/galvo.c **** #define XY_BUF_WORDS    (XY_BEATS * 2U)     /* 乒乓双缓冲: 两帧共 40 个 word */
  26:Galvo/galvo.c **** 
  27:Galvo/galvo.c **** /* GPIOB->BSRR 位掩码 (低 16 位=置位, 高 16 位=复位) */
  28:Galvo/galvo.c **** #define M_SYNC          (1UL << 7)          /* PB7 */
  29:Galvo/galvo.c **** #define M_X             (1UL << 5)          /* PB5 */
ARM GAS  C:\Users\Lenovo\AppData\Local\Temp\ccEfKiKn.s 			page 2


  30:Galvo/galvo.c **** #define M_Y             (1UL << 6)          /* PB6 */
  31:Galvo/galvo.c **** 
  32:Galvo/galvo.c **** /* 一个 BSRR 控制字: 同时确定 SYNC/X/Y 三条线的电平 */
  33:Galvo/galvo.c **** #define BSRR_LEVEL(mask, lvl)  ((lvl) ? (mask) : ((mask) << 16))
  34:Galvo/galvo.c **** 
  35:Galvo/galvo.c **** /* ---- 双半区缓冲 ---------------------------------------------------------- */
  36:Galvo/galvo.c **** static uint32_t galvo_frame[2][XY_BEATS];   /* DMA 搬运区，[0]=A 半区，[1]=B 半区 */
  37:Galvo/galvo.c **** static uint32_t galvo_stage[XY_BEATS];      /* 主循环编码区 */
  38:Galvo/galvo.c **** 
  39:Galvo/galvo.c **** /* 代号：stage 写完才自增；半区拷贝完才跟上，主循环据此判断能否覆盖 st
  40:Galvo/galvo.c **** static volatile uint32_t galvo_stage_gen = 0U;
  41:Galvo/galvo.c **** static volatile uint32_t galvo_a_gen = 0U;
  42:Galvo/galvo.c **** static volatile uint32_t galvo_b_gen = 0U;
  43:Galvo/galvo.c **** 
  44:Galvo/galvo.c **** static uint8_t galvo_ctrl = 0x1U;           /* 控制字 001 */
  45:Galvo/galvo.c **** 
  46:Galvo/galvo.c **** static volatile uint32_t galvo_drop = 0U;
  47:Galvo/galvo.c **** static volatile uint32_t galvo_dma_err = 0U;
  48:Galvo/galvo.c **** 
  49:Galvo/galvo.c **** /* ---- 调试计时 ---- */
  50:Galvo/galvo.c **** volatile uint32_t g_dma_copy_cycles = 0U;
  51:Galvo/galvo.c **** volatile uint32_t g_rx_to_dma_cycles = 0U;
  52:Galvo/galvo.c **** 
  53:Galvo/galvo.c **** /* ---- 内部函数 ------------------------------------------------------------ */
  54:Galvo/galvo.c **** static float galvo_lut_sample(const int16_t lut[GALVO_LUT_SIZE][GALVO_LUT_SIZE],
  55:Galvo/galvo.c ****                               uint32_t ax, uint32_t ay);
  56:Galvo/galvo.c **** static uint16_t galvo_axis_cmd(int32_t d, uint32_t ax, uint32_t ay,
  57:Galvo/galvo.c ****                                const int16_t lut[GALVO_LUT_SIZE][GALVO_LUT_SIZE],
  58:Galvo/galvo.c ****                                float offset);
  59:Galvo/galvo.c **** static void galvo_build_stage(int16_t x, int16_t y, uint32_t *buf);
  60:Galvo/galvo.c **** static void galvo_encode(uint16_t cx, uint16_t cy, uint32_t *buf);
  61:Galvo/galvo.c **** static void galvo_dma_half_cb(DMA_HandleTypeDef *hdma);
  62:Galvo/galvo.c **** static void galvo_dma_cplt_cb(DMA_HandleTypeDef *hdma);
  63:Galvo/galvo.c **** static void galvo_dma_error_cb(DMA_HandleTypeDef *hdma);
  64:Galvo/galvo.c **** 
  65:Galvo/galvo.c **** /* ---- LUT ---------------------------------------------------------------- */
  66:Galvo/galvo.c **** 
  67:Galvo/galvo.c **** /**
  68:Galvo/galvo.c ****   * @brief 双线性插值取样，ax/ay 为坐标绝对值（0..32768）
  69:Galvo/galvo.c ****   * @retval 校正量（弧度），未标定时为 0
  70:Galvo/galvo.c ****   */
  71:Galvo/galvo.c **** static float galvo_lut_sample(const int16_t lut[GALVO_LUT_SIZE][GALVO_LUT_SIZE],
  72:Galvo/galvo.c ****                               uint32_t ax, uint32_t ay)
  73:Galvo/galvo.c **** {
  74:Galvo/galvo.c ****   uint32_t ix, iy;
  75:Galvo/galvo.c ****   float fx, fy, v00, v10, v01, v11, top, bot;
  76:Galvo/galvo.c **** 
  77:Galvo/galvo.c ****   if (ax > 32767U) { ax = 32767U; }
  78:Galvo/galvo.c ****   if (ay > 32767U) { ay = 32767U; }
  79:Galvo/galvo.c **** 
  80:Galvo/galvo.c ****   ix = ax >> 8;
  81:Galvo/galvo.c ****   iy = ay >> 8;
  82:Galvo/galvo.c **** 
  83:Galvo/galvo.c ****   /* 插值需要 i+1，索引限制在 0..126；末段的分数部分截到 1.0 */
  84:Galvo/galvo.c ****   if (ix > (GALVO_LUT_SIZE - 2U)) { ix = GALVO_LUT_SIZE - 2U; }
  85:Galvo/galvo.c ****   if (iy > (GALVO_LUT_SIZE - 2U)) { iy = GALVO_LUT_SIZE - 2U; }
  86:Galvo/galvo.c **** 
ARM GAS  C:\Users\Lenovo\AppData\Local\Temp\ccEfKiKn.s 			page 3


  87:Galvo/galvo.c ****   fx = (float)(ax - (ix << 8)) * (1.0f / 256.0f);
  88:Galvo/galvo.c ****   fy = (float)(ay - (iy << 8)) * (1.0f / 256.0f);
  89:Galvo/galvo.c ****   if (fx > 1.0f) { fx = 1.0f; }
  90:Galvo/galvo.c ****   if (fy > 1.0f) { fy = 1.0f; }
  91:Galvo/galvo.c **** 
  92:Galvo/galvo.c ****   v00 = (float)lut[iy][ix];
  93:Galvo/galvo.c ****   v10 = (float)lut[iy][ix + 1U];
  94:Galvo/galvo.c ****   v01 = (float)lut[iy + 1U][ix];
  95:Galvo/galvo.c ****   v11 = (float)lut[iy + 1U][ix + 1U];
  96:Galvo/galvo.c **** 
  97:Galvo/galvo.c ****   top = v00 + (v10 - v00) * fx;
  98:Galvo/galvo.c ****   bot = v01 + (v11 - v01) * fx;
  99:Galvo/galvo.c ****   return (top + (bot - top) * fy) * GALVO_LUT_UNIT;
 100:Galvo/galvo.c **** }
 101:Galvo/galvo.c **** 
 102:Galvo/galvo.c **** /**
 103:Galvo/galvo.c ****   * @brief 单轴：α = sgn(d) × (|d|/(2f) + LUT)，再换算成 16bit 命令字
 104:Galvo/galvo.c ****   *
 105:Galvo/galvo.c ****   * @param  d      有符号坐标
 106:Galvo/galvo.c ****   * @param  ax/ay  坐标绝对值，用于查表
 107:Galvo/galvo.c ****   * @param  offset 该轴的零点角度 α0/β0
 108:Galvo/galvo.c ****   */
 109:Galvo/galvo.c **** static uint16_t galvo_axis_cmd(int32_t d, uint32_t ax, uint32_t ay,
 110:Galvo/galvo.c ****                                const int16_t lut[GALVO_LUT_SIZE][GALVO_LUT_SIZE],
 111:Galvo/galvo.c ****                                float offset)
 112:Galvo/galvo.c **** {
 113:Galvo/galvo.c ****   float ang = (float)ax / (2.0f * GALVO_F) + galvo_lut_sample(lut, ax, ay);
 114:Galvo/galvo.c ****   int32_t cmd;
 115:Galvo/galvo.c **** 
 116:Galvo/galvo.c ****   if (d < 0) { ang = -ang; }
 117:Galvo/galvo.c **** 
 118:Galvo/galvo.c ****   cmd = (int32_t)lroundf((ang - offset) * GALVO_COUNTS_PER_RAD + GALVO_CMD_CENTER);
 119:Galvo/galvo.c **** 
 120:Galvo/galvo.c ****   if (cmd < 0)      { cmd = 0; }
 121:Galvo/galvo.c ****   if (cmd > 65535)  { cmd = 65535; }
 122:Galvo/galvo.c **** 
 123:Galvo/galvo.c ****   return (uint16_t)cmd;
 124:Galvo/galvo.c **** }
 125:Galvo/galvo.c **** 
 126:Galvo/galvo.c **** /**
 127:Galvo/galvo.c ****   * @brief 把一对坐标换算成命令字并编码成一帧 20 个 BSRR 控制字
 128:Galvo/galvo.c ****   */
 129:Galvo/galvo.c **** static void galvo_build_stage(int16_t x, int16_t y, uint32_t *buf)
 130:Galvo/galvo.c **** {
 131:Galvo/galvo.c ****   uint32_t ax = (uint32_t)(x < 0 ? -(int32_t)x : (int32_t)x);
 132:Galvo/galvo.c ****   uint32_t ay = (uint32_t)(y < 0 ? -(int32_t)y : (int32_t)y);
 133:Galvo/galvo.c **** 
 134:Galvo/galvo.c ****   uint16_t cx = galvo_axis_cmd(x, ax, ay, galvo_lut_alpha, GALVO_ALPHA0);
 135:Galvo/galvo.c ****   uint16_t cy = galvo_axis_cmd(y, ax, ay, galvo_lut_beta,  GALVO_BETA0);
 136:Galvo/galvo.c **** 
 137:Galvo/galvo.c ****   galvo_encode(cx, cy, buf);
 138:Galvo/galvo.c **** }
 139:Galvo/galvo.c **** 
 140:Galvo/galvo.c **** /**
 141:Galvo/galvo.c ****   * @brief 编码一帧 XY2-100
 142:Galvo/galvo.c ****   *
 143:Galvo/galvo.c ****   * 20 bit, MSB first:
ARM GAS  C:\Users\Lenovo\AppData\Local\Temp\ccEfKiKn.s 			page 4


 144:Galvo/galvo.c ****   *   bit 0..2   C2 C1 C0（控制字）
 145:Galvo/galvo.c ****   *   bit 3..18  16bit 命令字，offset binary
 146:Galvo/galvo.c ****   *   bit 19     偶校验（对前 19 位异或）
 147:Galvo/galvo.c ****   * SYNC 前 19 拍为高，第 20 拍拉低。
 148:Galvo/galvo.c ****   */
 149:Galvo/galvo.c **** static void galvo_encode(uint16_t cx, uint16_t cy, uint32_t *buf)
 150:Galvo/galvo.c **** {
 151:Galvo/galvo.c ****   uint32_t ctrl = ((uint32_t)galvo_ctrl & 0x7U) << 16;
 152:Galvo/galvo.c ****   uint32_t wx = ctrl | cx;
 153:Galvo/galvo.c ****   uint32_t wy = ctrl | cy;
 154:Galvo/galvo.c ****   uint32_t px = 0U, py = 0U;
 155:Galvo/galvo.c **** 
 156:Galvo/galvo.c ****   for (uint32_t i = 0U; i < 19U; i++)
 157:Galvo/galvo.c ****   {
 158:Galvo/galvo.c ****     uint32_t bx = (wx >> (18U - i)) & 1U;
 159:Galvo/galvo.c ****     uint32_t by = (wy >> (18U - i)) & 1U;
 160:Galvo/galvo.c **** 
 161:Galvo/galvo.c ****     px ^= bx;
 162:Galvo/galvo.c ****     py ^= by;
 163:Galvo/galvo.c **** 
 164:Galvo/galvo.c ****     /* 三条线每个节拍都必须明确置位或复位，BSRR 没有"保持"语义 */
 165:Galvo/galvo.c ****     buf[i] = BSRR_LEVEL(M_SYNC, 1U) | BSRR_LEVEL(M_X, bx) | BSRR_LEVEL(M_Y, by);
 166:Galvo/galvo.c ****   }
 167:Galvo/galvo.c **** 
 168:Galvo/galvo.c ****   buf[19] = BSRR_LEVEL(M_SYNC, 0U) | BSRR_LEVEL(M_X, px) | BSRR_LEVEL(M_Y, py);
 169:Galvo/galvo.c **** }
 170:Galvo/galvo.c **** 
 171:Galvo/galvo.c **** /* ---- DMA 中断：帧边界搬运 ------------------------------------------------ */
 172:Galvo/galvo.c **** 
 173:Galvo/galvo.c **** /* 上半区(A)刚发完，DMA 正在发 B，可以重填 A */
 174:Galvo/galvo.c **** static void galvo_dma_half_cb(DMA_HandleTypeDef *hdma)
 175:Galvo/galvo.c **** {
 176:Galvo/galvo.c ****   if (hdma->Instance == DMA2_Stream5)
 177:Galvo/galvo.c ****   {
 178:Galvo/galvo.c ****     if (galvo_a_gen != galvo_stage_gen)
 179:Galvo/galvo.c ****     {
 180:Galvo/galvo.c ****       uint32_t a = DWT->CYCCNT;             /* 拷贝前 */
 181:Galvo/galvo.c ****       uint32_t b;
 182:Galvo/galvo.c **** 
 183:Galvo/galvo.c ****       memcpy(galvo_frame[0], galvo_stage, sizeof(galvo_stage));
 184:Galvo/galvo.c ****       __DMB();
 185:Galvo/galvo.c ****       galvo_a_gen = galvo_stage_gen;
 186:Galvo/galvo.c **** 
 187:Galvo/galvo.c ****       b = DWT->CYCCNT;                      /* 拷贝后 */
 188:Galvo/galvo.c ****       g_dma_copy_cycles = b - a;
 189:Galvo/galvo.c ****       g_rx_to_dma_cycles = b - g_comm_last_rx_cycle;
 190:Galvo/galvo.c ****     }
 191:Galvo/galvo.c ****   }
 192:Galvo/galvo.c **** }
 193:Galvo/galvo.c **** 
 194:Galvo/galvo.c **** /* 下半区(B)刚发完，DMA 绕回 A，可以重填 B */
 195:Galvo/galvo.c **** static void galvo_dma_cplt_cb(DMA_HandleTypeDef *hdma)
 196:Galvo/galvo.c **** {
 197:Galvo/galvo.c ****   if (hdma->Instance == DMA2_Stream5)
 198:Galvo/galvo.c ****   {
 199:Galvo/galvo.c ****     if (galvo_b_gen != galvo_stage_gen)
 200:Galvo/galvo.c ****     {
ARM GAS  C:\Users\Lenovo\AppData\Local\Temp\ccEfKiKn.s 			page 5


 201:Galvo/galvo.c ****       uint32_t a = DWT->CYCCNT;             /* 拷贝前 */
 202:Galvo/galvo.c ****       uint32_t b;
 203:Galvo/galvo.c **** 
 204:Galvo/galvo.c ****       memcpy(galvo_frame[1], galvo_stage, sizeof(galvo_stage));
 205:Galvo/galvo.c ****       __DMB();
 206:Galvo/galvo.c ****       galvo_b_gen = galvo_stage_gen;
 207:Galvo/galvo.c **** 
 208:Galvo/galvo.c ****       b = DWT->CYCCNT;                      /* 拷贝后 */
 209:Galvo/galvo.c ****       g_dma_copy_cycles = b - a;
 210:Galvo/galvo.c ****       g_rx_to_dma_cycles = b - g_comm_last_rx_cycle;
 211:Galvo/galvo.c ****     }
 212:Galvo/galvo.c ****   }
 213:Galvo/galvo.c **** }
