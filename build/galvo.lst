   1:Galvo/galvo.c **** /**
   2:Galvo/galvo.c ****   ******************************************************************************
   3:Galvo/galvo.c ****   * @file    galvo.c
   4:Galvo/galvo.c ****   * @brief   XY2-100 输出：坐标 → 角度 → 命令字 → 20 拍 BSRR 编码 → 循环 DMA
   5:Galvo/galvo.c ****   *
   6:Galvo/galvo.c ****   * 分工：
   7:Galvo/galvo.c ****   *   - 主循环 Galvo_Task()：取点、查 LUT、换算、编码到 stage[]，发布代号；
   8:Galvo/galvo.c ****   *   - DMA 中断：帧边界把 stage[] 拷到刚发完的那半区（A/B 乒乓）；
   9:Galvo/galvo.c ****   *   - DMA 硬件：循环读取 40 个 word 写 GPIOB->BSRR，永不停止。
  10:Galvo/galvo.c ****   * 因此波形连续性由硬件保证，软件只在帧边界改数据。
  11:Galvo/galvo.c ****   ******************************************************************************
  12:Galvo/galvo.c ****   */
  13:Galvo/galvo.c **** 
  14:Galvo/galvo.c **** #include "galvo.h"
  15:Galvo/galvo.c **** #include "galvo_lut.h"
  16:Galvo/galvo.c **** #include "comm.h"
  17:Galvo/galvo.c **** #include "scurve.h"
  18:Galvo/galvo.c **** #include "laser.h"
  19:Galvo/galvo.c **** #include "tim.h"
  20:Galvo/galvo.c **** #include "main.h"
  21:Galvo/galvo.c **** 
  22:Galvo/galvo.c **** #include <string.h>
  23:Galvo/galvo.c **** #include <math.h>
  24:Galvo/galvo.c **** 
  25:Galvo/galvo.c **** /* ---- XY2-100 帧结构 ------------------------------------------------------ */
  26:Galvo/galvo.c **** #define XY_BEATS        20U                 /* 一帧 20 个时钟周期            */
  27:Galvo/galvo.c **** #define XY_BUF_WORDS    (XY_BEATS * 2U)     /* 乒乓双缓冲: 两帧共 40 个 word */
  28:Galvo/galvo.c **** 
  29:Galvo/galvo.c **** /* GPIOB->BSRR 位掩码 (低 16 位=置位, 高 16 位=复位) */
ARM GAS  C:\Users\Lenovo\AppData\Local\Temp\cch7O12j.s 			page 2


  30:Galvo/galvo.c **** #define M_SYNC          (1UL << 7)          /* PB7 */
  31:Galvo/galvo.c **** #define M_X             (1UL << 5)          /* PB5 */
  32:Galvo/galvo.c **** #define M_Y             (1UL << 6)          /* PB6 */
  33:Galvo/galvo.c **** 
  34:Galvo/galvo.c **** /* 一个 BSRR 控制字: 同时确定 SYNC/X/Y 三条线的电平 */
  35:Galvo/galvo.c **** #define BSRR_LEVEL(mask, lvl)  ((lvl) ? (mask) : ((mask) << 16))
  36:Galvo/galvo.c **** 
  37:Galvo/galvo.c **** /* ---- 双半区缓冲 ---------------------------------------------------------- */
  38:Galvo/galvo.c **** static uint32_t galvo_frame[2][XY_BEATS];   /* DMA 搬运区，[0]=A 半区，[1]=B 半区 */
  39:Galvo/galvo.c **** static uint32_t galvo_stage[XY_BEATS];      /* 主循环编码区 */
  40:Galvo/galvo.c **** 
  41:Galvo/galvo.c **** /* 代号：stage 写完才自增；半区拷贝完才跟上，主循环据此判断能否覆盖 st
  42:Galvo/galvo.c **** static volatile uint32_t galvo_stage_gen = 0U;
  43:Galvo/galvo.c **** static volatile uint32_t galvo_a_gen = 0U;
  44:Galvo/galvo.c **** static volatile uint32_t galvo_b_gen = 0U;
  45:Galvo/galvo.c **** 
  46:Galvo/galvo.c **** static uint8_t galvo_ctrl = 0x1U;           /* 控制字 001 */
  47:Galvo/galvo.c **** 
  48:Galvo/galvo.c **** static volatile uint32_t galvo_dma_err = 0U;
  49:Galvo/galvo.c **** 
  50:Galvo/galvo.c **** /* ---- S 曲线规划 ---------------------------------------------------------- */
  51:Galvo/galvo.c **** typedef enum
  52:Galvo/galvo.c **** {
  53:Galvo/galvo.c ****   GALVO_IDLE = 0,               /* 等待下一个目标点 */
  54:Galvo/galvo.c ****   GALVO_MOVING                  /* 正在按 S 曲线走向目标点 */
  55:Galvo/galvo.c **** } galvo_plan_state_t;
  56:Galvo/galvo.c **** 
  57:Galvo/galvo.c **** static SCurve galvo_scurve;
  58:Galvo/galvo.c **** static galvo_plan_state_t galvo_plan_state = GALVO_IDLE;
  59:Galvo/galvo.c **** static int16_t galvo_cur_x = 0;            /* 当前输出的坐标 */
  60:Galvo/galvo.c **** static int16_t galvo_cur_y = 0;
  61:Galvo/galvo.c **** static uint32_t galvo_last_point_cycle = 0U;   /* 上一个规划点的输出时刻 */
  62:Galvo/galvo.c **** static uint32_t galvo_last_arrive_cycle = 0U;  /* 到达上一个目标点的时刻 */
  63:Galvo/galvo.c **** 
  64:Galvo/galvo.c **** /* µs → DWT 周期（168 MHz 下 1 µs = 168 周期） */
  65:Galvo/galvo.c **** static uint32_t galvo_us_to_cycles(uint32_t us)
  66:Galvo/galvo.c **** {
  67:Galvo/galvo.c ****   return us * (SystemCoreClock / 1000000U);
  68:Galvo/galvo.c **** }
  69:Galvo/galvo.c **** 
  70:Galvo/galvo.c **** /* ---- 调试计时 ---- */
  71:Galvo/galvo.c **** volatile uint32_t g_dma_copy_cycles = 0U;
  72:Galvo/galvo.c **** volatile uint32_t g_rx_to_dma_cycles = 0U;
  73:Galvo/galvo.c **** 
  74:Galvo/galvo.c **** /* ---- 内部函数 ------------------------------------------------------------ */
  75:Galvo/galvo.c **** static float galvo_lut_sample(const int16_t lut[GALVO_LUT_SIZE][GALVO_LUT_SIZE],
  76:Galvo/galvo.c ****                               uint32_t ax, uint32_t ay);
  77:Galvo/galvo.c **** static uint16_t galvo_axis_cmd(int32_t d, uint32_t ax, uint32_t ay,
  78:Galvo/galvo.c ****                                const int16_t lut[GALVO_LUT_SIZE][GALVO_LUT_SIZE],
  79:Galvo/galvo.c ****                                float offset);
  80:Galvo/galvo.c **** static void galvo_build_stage(int16_t x, int16_t y, uint32_t *buf);
  81:Galvo/galvo.c **** static void galvo_encode(uint16_t cx, uint16_t cy, uint32_t *buf);
  82:Galvo/galvo.c **** static void galvo_dma_half_cb(DMA_HandleTypeDef *hdma);
  83:Galvo/galvo.c **** static void galvo_dma_cplt_cb(DMA_HandleTypeDef *hdma);
  84:Galvo/galvo.c **** static void galvo_dma_error_cb(DMA_HandleTypeDef *hdma);
