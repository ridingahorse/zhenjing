  80:Galvo/galvo.c **** volatile uint32_t gtest_t[GTEST_SEGS][SCURVE_POINTS];   /* 7 个点的输出时刻 */
  81:Galvo/galvo.c **** volatile int16_t  gtest_x[GTEST_SEGS][SCURVE_POINTS];
  82:Galvo/galvo.c **** volatile int16_t  gtest_y[GTEST_SEGS][SCURVE_POINTS];
  83:Galvo/galvo.c **** volatile uint32_t gtest_dt[GTEST_SEGS][SCURVE_POINTS];  /* 与上一个点的间隔 */
  84:Galvo/galvo.c **** volatile uint32_t gtest_settle[GTEST_SEGS];             /* 末点 → 稳定到期 */
  85:Galvo/galvo.c **** volatile uint32_t gtest_total[GTEST_SEGS];              /* 首点 → 稳定到期 */
  86:Galvo/galvo.c **** volatile uint8_t  gtest_seg = 0U;                       /* 已记录的段数 */
