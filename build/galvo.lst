  86:Galvo/galvo.c **** /* ---- LUT ---------------------------------------------------------------- */
ARM GAS  C:\Users\Lenovo\AppData\Local\Temp\cch7O12j.s 			page 3


  87:Galvo/galvo.c **** 
  88:Galvo/galvo.c **** /**
  89:Galvo/galvo.c ****   * @brief 双线性插值取样，ax/ay 为坐标绝对值（0..32768）
  90:Galvo/galvo.c ****   * @retval 校正量（弧度），未标定时为 0
  91:Galvo/galvo.c ****   */
  92:Galvo/galvo.c **** static float galvo_lut_sample(const int16_t lut[GALVO_LUT_SIZE][GALVO_LUT_SIZE],
  93:Galvo/galvo.c ****                               uint32_t ax, uint32_t ay)
  94:Galvo/galvo.c **** {
  95:Galvo/galvo.c ****   uint32_t ix, iy;
  96:Galvo/galvo.c ****   float fx, fy, v00, v10, v01, v11, top, bot;
  97:Galvo/galvo.c **** 
  98:Galvo/galvo.c ****   if (ax > 32767U) { ax = 32767U; }
  99:Galvo/galvo.c ****   if (ay > 32767U) { ay = 32767U; }
 100:Galvo/galvo.c **** 
 101:Galvo/galvo.c ****   ix = ax >> 8;
 102:Galvo/galvo.c ****   iy = ay >> 8;
 103:Galvo/galvo.c **** 
 104:Galvo/galvo.c ****   /* 插值需要 i+1，索引限制在 0..126；末段的分数部分截到 1.0 */
 105:Galvo/galvo.c ****   if (ix > (GALVO_LUT_SIZE - 2U)) { ix = GALVO_LUT_SIZE - 2U; }
 106:Galvo/galvo.c ****   if (iy > (GALVO_LUT_SIZE - 2U)) { iy = GALVO_LUT_SIZE - 2U; }
 107:Galvo/galvo.c **** 
 108:Galvo/galvo.c ****   fx = (float)(ax - (ix << 8)) * (1.0f / 256.0f);
 109:Galvo/galvo.c ****   fy = (float)(ay - (iy << 8)) * (1.0f / 256.0f);
 110:Galvo/galvo.c ****   if (fx > 1.0f) { fx = 1.0f; }
 111:Galvo/galvo.c ****   if (fy > 1.0f) { fy = 1.0f; }
 112:Galvo/galvo.c **** 
 113:Galvo/galvo.c ****   v00 = (float)lut[iy][ix];
 114:Galvo/galvo.c ****   v10 = (float)lut[iy][ix + 1U];
 115:Galvo/galvo.c ****   v01 = (float)lut[iy + 1U][ix];
 116:Galvo/galvo.c ****   v11 = (float)lut[iy + 1U][ix + 1U];
 117:Galvo/galvo.c **** 
 118:Galvo/galvo.c ****   top = v00 + (v10 - v00) * fx;
 119:Galvo/galvo.c ****   bot = v01 + (v11 - v01) * fx;
 120:Galvo/galvo.c ****   return (top + (bot - top) * fy) * GALVO_LUT_UNIT;
 121:Galvo/galvo.c **** }
 122:Galvo/galvo.c **** 
 123:Galvo/galvo.c **** /**
 124:Galvo/galvo.c ****   * @brief 单轴：α = sgn(d) × (|d|/(2f) + LUT)，再换算成 16bit 命令字
 125:Galvo/galvo.c ****   *
 126:Galvo/galvo.c ****   * @param  d      有符号坐标
 127:Galvo/galvo.c ****   * @param  ax/ay  坐标绝对值，用于查表
 128:Galvo/galvo.c ****   * @param  offset 该轴的零点角度 α0/β0
 129:Galvo/galvo.c ****   */
 130:Galvo/galvo.c **** static uint16_t galvo_axis_cmd(int32_t d, uint32_t ax, uint32_t ay,
 131:Galvo/galvo.c ****                                const int16_t lut[GALVO_LUT_SIZE][GALVO_LUT_SIZE],
 132:Galvo/galvo.c ****                                float offset)
 133:Galvo/galvo.c **** {
 134:Galvo/galvo.c ****   float ang = (float)ax / (2.0f * GALVO_F) + galvo_lut_sample(lut, ax, ay);
 135:Galvo/galvo.c ****   int32_t cmd;
 136:Galvo/galvo.c **** 
 137:Galvo/galvo.c ****   if (d < 0) { ang = -ang; }
 138:Galvo/galvo.c **** 
 139:Galvo/galvo.c ****   cmd = (int32_t)lroundf((ang - offset) * GALVO_COUNTS_PER_RAD + GALVO_CMD_CENTER);
 140:Galvo/galvo.c **** 
 141:Galvo/galvo.c ****   if (cmd < 0)      { cmd = 0; }
 142:Galvo/galvo.c ****   if (cmd > 65535)  { cmd = 65535; }
 143:Galvo/galvo.c **** 
ARM GAS  C:\Users\Lenovo\AppData\Local\Temp\cch7O12j.s 			page 4


 144:Galvo/galvo.c ****   return (uint16_t)cmd;
 145:Galvo/galvo.c **** }
 146:Galvo/galvo.c **** 
 147:Galvo/galvo.c **** /**
 148:Galvo/galvo.c ****   * @brief 把一对坐标换算成命令字并编码成一帧 20 个 BSRR 控制字
 149:Galvo/galvo.c ****   */
 150:Galvo/galvo.c **** static void galvo_build_stage(int16_t x, int16_t y, uint32_t *buf)
 151:Galvo/galvo.c **** {
 152:Galvo/galvo.c ****   uint32_t ax = (uint32_t)(x < 0 ? -(int32_t)x : (int32_t)x);
 153:Galvo/galvo.c ****   uint32_t ay = (uint32_t)(y < 0 ? -(int32_t)y : (int32_t)y);
 154:Galvo/galvo.c **** 
 155:Galvo/galvo.c ****   uint16_t cx = galvo_axis_cmd(x, ax, ay, galvo_lut_alpha, GALVO_ALPHA0);
 156:Galvo/galvo.c ****   uint16_t cy = galvo_axis_cmd(y, ax, ay, galvo_lut_beta,  GALVO_BETA0);
 157:Galvo/galvo.c **** 
 158:Galvo/galvo.c ****   galvo_encode(cx, cy, buf);
 159:Galvo/galvo.c **** }
 160:Galvo/galvo.c **** 
 161:Galvo/galvo.c **** /**
 162:Galvo/galvo.c ****   * @brief 编码一帧 XY2-100
 163:Galvo/galvo.c ****   *
 164:Galvo/galvo.c ****   * 20 bit, MSB first:
 165:Galvo/galvo.c ****   *   bit 0..2   C2 C1 C0（控制字）
 166:Galvo/galvo.c ****   *   bit 3..18  16bit 命令字，offset binary
 167:Galvo/galvo.c ****   *   bit 19     偶校验（对前 19 位异或）
 168:Galvo/galvo.c ****   * SYNC 前 19 拍为高，第 20 拍拉低。
 169:Galvo/galvo.c ****   */
 170:Galvo/galvo.c **** static void galvo_encode(uint16_t cx, uint16_t cy, uint32_t *buf)
 171:Galvo/galvo.c **** {
 172:Galvo/galvo.c ****   uint32_t ctrl = ((uint32_t)galvo_ctrl & 0x7U) << 16;
 173:Galvo/galvo.c ****   uint32_t wx = ctrl | cx;
 174:Galvo/galvo.c ****   uint32_t wy = ctrl | cy;
 175:Galvo/galvo.c ****   uint32_t px = 0U, py = 0U;
 176:Galvo/galvo.c **** 
 177:Galvo/galvo.c ****   for (uint32_t i = 0U; i < 19U; i++)
 178:Galvo/galvo.c ****   {
 179:Galvo/galvo.c ****     uint32_t bx = (wx >> (18U - i)) & 1U;
 180:Galvo/galvo.c ****     uint32_t by = (wy >> (18U - i)) & 1U;
 181:Galvo/galvo.c **** 
 182:Galvo/galvo.c ****     px ^= bx;
 183:Galvo/galvo.c ****     py ^= by;
 184:Galvo/galvo.c **** 
 185:Galvo/galvo.c ****     /* 三条线每个节拍都必须明确置位或复位，BSRR 没有"保持"语义 */
 186:Galvo/galvo.c ****     buf[i] = BSRR_LEVEL(M_SYNC, 1U) | BSRR_LEVEL(M_X, bx) | BSRR_LEVEL(M_Y, by);
 187:Galvo/galvo.c ****   }
 188:Galvo/galvo.c **** 
 189:Galvo/galvo.c ****   buf[19] = BSRR_LEVEL(M_SYNC, 0U) | BSRR_LEVEL(M_X, px) | BSRR_LEVEL(M_Y, py);
 190:Galvo/galvo.c **** }
 191:Galvo/galvo.c **** 
 192:Galvo/galvo.c **** /* ---- DMA 中断：帧边界搬运 ------------------------------------------------ */
 193:Galvo/galvo.c **** 
 194:Galvo/galvo.c **** /* 上半区(A)刚发完，DMA 正在发 B，可以重填 A */
 195:Galvo/galvo.c **** static void galvo_dma_half_cb(DMA_HandleTypeDef *hdma)
 196:Galvo/galvo.c **** {
 197:Galvo/galvo.c ****   if (hdma->Instance == DMA2_Stream5)
 198:Galvo/galvo.c ****   {
 199:Galvo/galvo.c ****     if (galvo_a_gen != galvo_stage_gen)
 200:Galvo/galvo.c ****     {
ARM GAS  C:\Users\Lenovo\AppData\Local\Temp\cch7O12j.s 			page 5


 201:Galvo/galvo.c ****       uint32_t a = DWT->CYCCNT;             /* 拷贝前 */
 202:Galvo/galvo.c ****       uint32_t b;
 203:Galvo/galvo.c **** 
 204:Galvo/galvo.c ****       memcpy(galvo_frame[0], galvo_stage, sizeof(galvo_stage));
 205:Galvo/galvo.c ****       __DMB();
 206:Galvo/galvo.c ****       galvo_a_gen = galvo_stage_gen;
 207:Galvo/galvo.c **** 
 208:Galvo/galvo.c ****       b = DWT->CYCCNT;                      /* 拷贝后 */
 209:Galvo/galvo.c ****       g_dma_copy_cycles = b - a;
 210:Galvo/galvo.c ****       g_rx_to_dma_cycles = b - g_comm_last_rx_cycle;
 211:Galvo/galvo.c ****     }
 212:Galvo/galvo.c ****   }
 213:Galvo/galvo.c **** }
 214:Galvo/galvo.c **** 
 215:Galvo/galvo.c **** /* 下半区(B)刚发完，DMA 绕回 A，可以重填 B */
 216:Galvo/galvo.c **** static void galvo_dma_cplt_cb(DMA_HandleTypeDef *hdma)
 217:Galvo/galvo.c **** {
 218:Galvo/galvo.c ****   if (hdma->Instance == DMA2_Stream5)
 219:Galvo/galvo.c ****   {
 220:Galvo/galvo.c ****     if (galvo_b_gen != galvo_stage_gen)
 221:Galvo/galvo.c ****     {
 222:Galvo/galvo.c ****       uint32_t a = DWT->CYCCNT;             /* 拷贝前 */
 223:Galvo/galvo.c ****       uint32_t b;
 224:Galvo/galvo.c **** 
 225:Galvo/galvo.c ****       memcpy(galvo_frame[1], galvo_stage, sizeof(galvo_stage));
 226:Galvo/galvo.c ****       __DMB();
 227:Galvo/galvo.c ****       galvo_b_gen = galvo_stage_gen;
 228:Galvo/galvo.c **** 
 229:Galvo/galvo.c ****       b = DWT->CYCCNT;                      /* 拷贝后 */
 230:Galvo/galvo.c ****       g_dma_copy_cycles = b - a;
 231:Galvo/galvo.c ****       g_rx_to_dma_cycles = b - g_comm_last_rx_cycle;
 232:Galvo/galvo.c ****     }
 233:Galvo/galvo.c ****   }
 234:Galvo/galvo.c **** }
