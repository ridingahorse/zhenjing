   1:Galvo/galvo.c **** /**
   2:Galvo/galvo.c ****   ******************************************************************************
   3:Galvo/galvo.c ****   * @file    galvo.c
   4:Galvo/galvo.c ****   * @brief   XY2-100 输出：坐标 → 角度 → 命令字 → 20 拍 BSRR 编码 → 循环 DMA
   5:Galvo/galvo.c ****   *
   6:Galvo/galvo.c ****   * 分工：
   7:Galvo/galvo.c ****   *   - 主循环 Galvo_Task()：取点、查 LUT、换算、编码到 stage[]，发布代号；
   8:Galvo/galvo.c ****   *   - DMA 中断：帧边界把 stage[] 拷到刚发完的那半区（A/B 乒乓）；
   9:Galvo/galvo.c ****   *   - DMA 硬件：循环读取 40 个 word 写 GPIOB->BSRR，永不停止。
  10:Galvo/galvo.c ****   * 因此波形连续性由硬件保证，软件只在帧边界改数据。
  11:Galvo/galvo.c ****   ******************************************************************************
  12:Galvo/galvo.c ****   */
  13:Galvo/galvo.c **** 
  14:Galvo/galvo.c **** #include "galvo.h"
  15:Galvo/galvo.c **** #include "comm.h"
  16:Galvo/galvo.c **** #include "scurve.h"
  17:Galvo/galvo.c **** #include "laser.h"
  18:Galvo/galvo.c **** #include "tim.h"
  19:Galvo/galvo.c **** #include "main.h"
  20:Galvo/galvo.c **** 
  21:Galvo/galvo.c **** #include <string.h>
  22:Galvo/galvo.c **** #include <math.h>
  23:Galvo/galvo.c **** 
  24:Galvo/galvo.c **** /* ---- XY2-100 帧结构 ------------------------------------------------------ */
  25:Galvo/galvo.c **** #define XY_BEATS        20U                 /* 一帧 20 个时钟周期            */
  26:Galvo/galvo.c **** #define XY_BUF_WORDS    (XY_BEATS * 2U)     /* 乒乓双缓冲: 两帧共 40 个 word */
  27:Galvo/galvo.c **** 
  28:Galvo/galvo.c **** /* GPIOB->BSRR 位掩码 (低 16 位=置位, 高 16 位=复位) */
  29:Galvo/galvo.c **** #define M_SYNC          (1UL << 7)          /* PB7 */
ARM GAS  C:\Users\Lenovo\AppData\Local\Temp\cc7JgQjd.s 			page 2


  30:Galvo/galvo.c **** #define M_X             (1UL << 5)          /* PB5 */
  31:Galvo/galvo.c **** #define M_Y             (1UL << 6)          /* PB6 */
  32:Galvo/galvo.c **** 
  33:Galvo/galvo.c **** /* 一个 BSRR 控制字: 同时确定 SYNC/X/Y 三条线的电平 */
  34:Galvo/galvo.c **** #define BSRR_LEVEL(mask, lvl)  ((lvl) ? (mask) : ((mask) << 16))
  35:Galvo/galvo.c **** 
  36:Galvo/galvo.c **** /* ---- 双半区缓冲 ---------------------------------------------------------- */
  37:Galvo/galvo.c **** static uint32_t galvo_frame[2][XY_BEATS];   /* DMA 搬运区，[0]=A 半区，[1]=B 半区 */
  38:Galvo/galvo.c **** static uint32_t galvo_stage[XY_BEATS];      /* 主循环编码区 */
  39:Galvo/galvo.c **** 
  40:Galvo/galvo.c **** /* 代号：stage 写完才自增；半区拷贝完才跟上，主循环据此判断能否覆盖 st
  41:Galvo/galvo.c **** static volatile uint32_t galvo_stage_gen = 0U;
  42:Galvo/galvo.c **** static volatile uint32_t galvo_a_gen = 0U;
  43:Galvo/galvo.c **** static volatile uint32_t galvo_b_gen = 0U;
  44:Galvo/galvo.c **** 
  45:Galvo/galvo.c **** static uint8_t galvo_ctrl = 0x1U;           /* 控制字 001 */
  46:Galvo/galvo.c **** 
  47:Galvo/galvo.c **** static volatile uint32_t galvo_dma_err = 0U;
  48:Galvo/galvo.c **** 
  49:Galvo/galvo.c **** /* ---- S 曲线规划 ---------------------------------------------------------- */
  50:Galvo/galvo.c **** typedef enum
  51:Galvo/galvo.c **** {
  52:Galvo/galvo.c ****   GALVO_IDLE = 0,               /* 等待下一个目标点 */
  53:Galvo/galvo.c ****   GALVO_MOVING                  /* 正在按 S 曲线走向目标点 */
  54:Galvo/galvo.c **** } galvo_plan_state_t;
  55:Galvo/galvo.c **** 
  56:Galvo/galvo.c **** static SCurve galvo_scurve;
  57:Galvo/galvo.c **** static galvo_plan_state_t galvo_plan_state = GALVO_IDLE;
  58:Galvo/galvo.c **** static int16_t galvo_cur_x = 0;            /* 当前输出的坐标 */
  59:Galvo/galvo.c **** static int16_t galvo_cur_y = 0;
  60:Galvo/galvo.c **** static uint32_t galvo_last_point_cycle = 0U;   /* 上一个规划点的输出时刻 */
  61:Galvo/galvo.c **** static uint32_t galvo_last_arrive_cycle = 0U;  /* 到达上一个目标点的时刻 */
  62:Galvo/galvo.c **** static uint8_t  galvo_laser_off_pending = 0U;  /* 已到位，待稳定结束后关光 */
  63:Galvo/galvo.c **** 
  64:Galvo/galvo.c **** /* µs → DWT 周期（168 MHz 下 1 µs = 168 周期） */
  65:Galvo/galvo.c **** static uint32_t galvo_us_to_cycles(uint32_t us)
  66:Galvo/galvo.c **** {
  67:Galvo/galvo.c ****   return us * (SystemCoreClock / 1000000U);
  68:Galvo/galvo.c **** }
  69:Galvo/galvo.c **** 
  70:Galvo/galvo.c **** /* ---- 调试计时 ---- */
  71:Galvo/galvo.c **** volatile uint32_t g_dma_copy_cycles = 0U;
  72:Galvo/galvo.c **** volatile uint32_t g_rx_to_dma_cycles = 0U;
  73:Galvo/galvo.c **** 
  74:Galvo/galvo.c **** /* ===================== 临时测试：S 曲线日志（测完整块删除） =============== */
  75:Galvo/galvo.c **** #define GALVO_TEST_LOG   1
  76:Galvo/galvo.c **** #if GALVO_TEST_LOG
  77:Galvo/galvo.c **** #define GTEST_SEGS       16U
  78:Galvo/galvo.c **** 
  79:Galvo/galvo.c **** volatile uint32_t gtest_t[GTEST_SEGS][SCURVE_POINTS];   /* 7 个点的输出时刻 */
  80:Galvo/galvo.c **** volatile int16_t  gtest_x[GTEST_SEGS][SCURVE_POINTS];
  81:Galvo/galvo.c **** volatile int16_t  gtest_y[GTEST_SEGS][SCURVE_POINTS];
  82:Galvo/galvo.c **** volatile uint32_t gtest_dt[GTEST_SEGS][SCURVE_POINTS];  /* 与上一个点的间隔 */
  83:Galvo/galvo.c **** volatile uint32_t gtest_settle[GTEST_SEGS];             /* 末点 → 稳定到期 */
  84:Galvo/galvo.c **** volatile uint32_t gtest_total[GTEST_SEGS];              /* 首点 → 稳定到期 */
  85:Galvo/galvo.c **** volatile uint8_t  gtest_seg = 0U;                       /* 已记录的段数 */
  86:Galvo/galvo.c **** 
ARM GAS  C:\Users\Lenovo\AppData\Local\Temp\cc7JgQjd.s 			page 3


  87:Galvo/galvo.c **** static uint32_t   gtest_last_t = 0U;
  88:Galvo/galvo.c **** static uint8_t    gtest_pending_seg = 0U;               /* 等待记录稳定时间的段 */
  89:Galvo/galvo.c **** static volatile uint8_t gtest_settle_pending = 0U;
  90:Galvo/galvo.c **** #endif
  91:Galvo/galvo.c **** /* ===================== 临时测试结束 ====================================== */
  92:Galvo/galvo.c **** 
  93:Galvo/galvo.c **** /* ---- 内部函数 ------------------------------------------------------------ */
  94:Galvo/galvo.c **** static uint16_t galvo_axis_cmd(int32_t d, float offset);
  95:Galvo/galvo.c **** static void galvo_build_stage(int16_t x, int16_t y, uint32_t *buf);
  96:Galvo/galvo.c **** static void galvo_encode(uint16_t cx, uint16_t cy, uint32_t *buf);
  97:Galvo/galvo.c **** static void galvo_dma_half_cb(DMA_HandleTypeDef *hdma);
  98:Galvo/galvo.c **** static void galvo_dma_cplt_cb(DMA_HandleTypeDef *hdma);
  99:Galvo/galvo.c **** static void galvo_dma_error_cb(DMA_HandleTypeDef *hdma);
 100:Galvo/galvo.c **** 
 101:Galvo/galvo.c **** #if GALVO_TEST_LOG
 102:Galvo/galvo.c **** static void gtest_record(uint32_t now, uint32_t step, int16_t x, int16_t y);
 103:Galvo/galvo.c **** #endif
 104:Galvo/galvo.c **** 
 105:Galvo/galvo.c **** /* ---- 坐标换算 ------------------------------------------------------------ */
 106:Galvo/galvo.c **** 
 107:Galvo/galvo.c **** /**
 108:Galvo/galvo.c ****   * @brief 单轴：α = sgn(d) × |d|/(2f)，再换算成 16bit 命令字
 109:Galvo/galvo.c ****   *
 110:Galvo/galvo.c ****   * @param  d      有符号坐标
 111:Galvo/galvo.c ****   * @param  offset 该轴的零点角度 α0/β0
 112:Galvo/galvo.c ****   */
 113:Galvo/galvo.c **** static uint16_t galvo_axis_cmd(int32_t d, float offset)
 114:Galvo/galvo.c **** {
 115:Galvo/galvo.c ****   float ang = (float)(d < 0 ? -d : d) / (2.0f * GALVO_F);
 116:Galvo/galvo.c ****   int32_t cmd;
 117:Galvo/galvo.c **** 
 118:Galvo/galvo.c ****   if (d < 0) { ang = -ang; }
 119:Galvo/galvo.c **** 
 120:Galvo/galvo.c ****   cmd = (int32_t)lroundf((ang - offset) * GALVO_COUNTS_PER_RAD + GALVO_CMD_CENTER);
 121:Galvo/galvo.c **** 
 122:Galvo/galvo.c ****   if (cmd < 0)      { cmd = 0; }
 123:Galvo/galvo.c ****   if (cmd > 65535)  { cmd = 65535; }
 124:Galvo/galvo.c **** 
 125:Galvo/galvo.c ****   return (uint16_t)cmd;
 126:Galvo/galvo.c **** }
 127:Galvo/galvo.c **** 
 128:Galvo/galvo.c **** /**
 129:Galvo/galvo.c ****   * @brief 把一对坐标换算成命令字并编码成一帧 20 个 BSRR 控制字
 130:Galvo/galvo.c ****   */
 131:Galvo/galvo.c **** static void galvo_build_stage(int16_t x, int16_t y, uint32_t *buf)
 132:Galvo/galvo.c **** {
 133:Galvo/galvo.c ****   uint16_t cx = galvo_axis_cmd(x, GALVO_ALPHA0);
 134:Galvo/galvo.c ****   uint16_t cy = galvo_axis_cmd(y, GALVO_BETA0);
 135:Galvo/galvo.c **** 
 136:Galvo/galvo.c ****   galvo_encode(cx, cy, buf);
 137:Galvo/galvo.c **** }
 138:Galvo/galvo.c **** 
 139:Galvo/galvo.c **** /**
 140:Galvo/galvo.c ****   * @brief 编码一帧 XY2-100
 141:Galvo/galvo.c ****   *
 142:Galvo/galvo.c ****   * 20 bit, MSB first:
 143:Galvo/galvo.c ****   *   bit 0..2   C2 C1 C0（控制字）
ARM GAS  C:\Users\Lenovo\AppData\Local\Temp\cc7JgQjd.s 			page 4


 144:Galvo/galvo.c ****   *   bit 3..18  16bit 命令字，offset binary
 145:Galvo/galvo.c ****   *   bit 19     偶校验（对前 19 位异或）
 146:Galvo/galvo.c ****   * SYNC 前 19 拍为高，第 20 拍拉低。
 147:Galvo/galvo.c ****   */
 148:Galvo/galvo.c **** static void galvo_encode(uint16_t cx, uint16_t cy, uint32_t *buf)
 149:Galvo/galvo.c **** {
 150:Galvo/galvo.c ****   uint32_t ctrl = ((uint32_t)galvo_ctrl & 0x7U) << 16;
 151:Galvo/galvo.c ****   uint32_t wx = ctrl | cx;
 152:Galvo/galvo.c ****   uint32_t wy = ctrl | cy;
 153:Galvo/galvo.c ****   uint32_t px = 0U, py = 0U;
 154:Galvo/galvo.c **** 
 155:Galvo/galvo.c ****   for (uint32_t i = 0U; i < 19U; i++)
 156:Galvo/galvo.c ****   {
 157:Galvo/galvo.c ****     uint32_t bx = (wx >> (18U - i)) & 1U;
 158:Galvo/galvo.c ****     uint32_t by = (wy >> (18U - i)) & 1U;
 159:Galvo/galvo.c **** 
 160:Galvo/galvo.c ****     px ^= bx;
 161:Galvo/galvo.c ****     py ^= by;
 162:Galvo/galvo.c **** 
 163:Galvo/galvo.c ****     /* 三条线每个节拍都必须明确置位或复位，BSRR 没有"保持"语义 */
 164:Galvo/galvo.c ****     buf[i] = BSRR_LEVEL(M_SYNC, 1U) | BSRR_LEVEL(M_X, bx) | BSRR_LEVEL(M_Y, by);
 165:Galvo/galvo.c ****   }
 166:Galvo/galvo.c **** 
 167:Galvo/galvo.c ****   buf[19] = BSRR_LEVEL(M_SYNC, 0U) | BSRR_LEVEL(M_X, px) | BSRR_LEVEL(M_Y, py);
 168:Galvo/galvo.c **** }
 169:Galvo/galvo.c **** 
 170:Galvo/galvo.c **** #if GALVO_TEST_LOG
 171:Galvo/galvo.c **** /* 记录一个规划点（只在主循环调用，写内存，不影响波形） */
 172:Galvo/galvo.c **** static void gtest_record(uint32_t now, uint32_t step, int16_t x, int16_t y)
 173:Galvo/galvo.c **** {
 174:Galvo/galvo.c ****   uint8_t s = gtest_seg;
 175:Galvo/galvo.c ****   uint32_t k;
 176:Galvo/galvo.c **** 
 177:Galvo/galvo.c ****   if ((s >= GTEST_SEGS) || (step == 0U) || (step > SCURVE_POINTS))
 178:Galvo/galvo.c ****   {
 179:Galvo/galvo.c ****     return;
 180:Galvo/galvo.c ****   }
 181:Galvo/galvo.c **** 
 182:Galvo/galvo.c ****   k = step - 1U;
 183:Galvo/galvo.c **** 
 184:Galvo/galvo.c ****   gtest_t[s][k] = now;
 185:Galvo/galvo.c ****   gtest_x[s][k] = x;
 186:Galvo/galvo.c ****   gtest_y[s][k] = y;
 187:Galvo/galvo.c ****   gtest_dt[s][k] = (gtest_last_t == 0U) ? 0U : (now - gtest_last_t);
 188:Galvo/galvo.c ****   gtest_last_t = now;
 189:Galvo/galvo.c **** 
 190:Galvo/galvo.c ****   if (k == (SCURVE_POINTS - 1U))
 191:Galvo/galvo.c ****   {
 192:Galvo/galvo.c ****     gtest_pending_seg = s;
 193:Galvo/galvo.c ****     gtest_settle_pending = 1U;
 194:Galvo/galvo.c ****     gtest_seg = (uint8_t)(s + 1U);      /* 等于 GTEST_SEGS 后停止记录 */
 195:Galvo/galvo.c ****   }
 196:Galvo/galvo.c **** }
 197:Galvo/galvo.c **** #endif
 198:Galvo/galvo.c **** 
 199:Galvo/galvo.c **** /* ---- DMA 中断：帧边界搬运 ------------------------------------------------ */
 200:Galvo/galvo.c **** 
ARM GAS  C:\Users\Lenovo\AppData\Local\Temp\cc7JgQjd.s 			page 5


 201:Galvo/galvo.c **** /* 上半区(A)刚发完，DMA 正在发 B，可以重填 A */
 202:Galvo/galvo.c **** static void galvo_dma_half_cb(DMA_HandleTypeDef *hdma)
 203:Galvo/galvo.c **** {
 204:Galvo/galvo.c ****   if (hdma->Instance == DMA2_Stream5)
 205:Galvo/galvo.c ****   {
 206:Galvo/galvo.c ****     if (galvo_a_gen != galvo_stage_gen)
 207:Galvo/galvo.c ****     {
 208:Galvo/galvo.c ****       uint32_t a = DWT->CYCCNT;             /* 拷贝前 */
 209:Galvo/galvo.c ****       uint32_t b;
 210:Galvo/galvo.c **** 
 211:Galvo/galvo.c ****       memcpy(galvo_frame[0], galvo_stage, sizeof(galvo_stage));
 212:Galvo/galvo.c ****       __DMB();
 213:Galvo/galvo.c ****       galvo_a_gen = galvo_stage_gen;
 214:Galvo/galvo.c **** 
 215:Galvo/galvo.c ****       b = DWT->CYCCNT;                      /* 拷贝后 */
 216:Galvo/galvo.c ****       g_dma_copy_cycles = b - a;
 217:Galvo/galvo.c ****       g_rx_to_dma_cycles = b - g_comm_last_rx_cycle;
 218:Galvo/galvo.c ****     }
 219:Galvo/galvo.c ****   }
 220:Galvo/galvo.c **** }
 221:Galvo/galvo.c **** 
 222:Galvo/galvo.c **** /* 下半区(B)刚发完，DMA 绕回 A，可以重填 B */
 223:Galvo/galvo.c **** static void galvo_dma_cplt_cb(DMA_HandleTypeDef *hdma)
 224:Galvo/galvo.c **** {
 225:Galvo/galvo.c ****   if (hdma->Instance == DMA2_Stream5)
 226:Galvo/galvo.c ****   {
 227:Galvo/galvo.c ****     if (galvo_b_gen != galvo_stage_gen)
 228:Galvo/galvo.c ****     {
 229:Galvo/galvo.c ****       uint32_t a = DWT->CYCCNT;             /* 拷贝前 */
 230:Galvo/galvo.c ****       uint32_t b;
 231:Galvo/galvo.c **** 
 232:Galvo/galvo.c ****       memcpy(galvo_frame[1], galvo_stage, sizeof(galvo_stage));
 233:Galvo/galvo.c ****       __DMB();
 234:Galvo/galvo.c ****       galvo_b_gen = galvo_stage_gen;
 235:Galvo/galvo.c **** 
 236:Galvo/galvo.c ****       b = DWT->CYCCNT;                      /* 拷贝后 */
 237:Galvo/galvo.c ****       g_dma_copy_cycles = b - a;
 238:Galvo/galvo.c ****       g_rx_to_dma_cycles = b - g_comm_last_rx_cycle;
 239:Galvo/galvo.c ****     }
 240:Galvo/galvo.c ****   }
 241:Galvo/galvo.c **** }
