  96:Galvo/galvo.c ****                               uint32_t ax, uint32_t ay);
  97:Galvo/galvo.c **** static uint16_t galvo_axis_cmd(int32_t d, uint32_t ax, uint32_t ay,
  98:Galvo/galvo.c ****                                const int16_t lut[GALVO_LUT_SIZE][GALVO_LUT_SIZE],
  99:Galvo/galvo.c ****                                float offset);
