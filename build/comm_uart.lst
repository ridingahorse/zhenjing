  26:Galvo/comm_uart.c **** #define COMM_HEAD0       0xAAU
  27:Galvo/comm_uart.c **** #define COMM_HEAD1       0x55U
  28:Galvo/comm_uart.c **** 
  29:Galvo/comm_uart.c **** typedef struct
